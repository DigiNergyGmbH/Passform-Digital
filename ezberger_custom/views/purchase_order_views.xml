<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_sale_order_id" model="ir.ui.view">
        <field name="name">purchase.order.form.sale.order.id</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="sale_order_id"
                       domain="[('partner_id', '=', partner_id)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="customer_contact_name" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_sale_order_id" model="ir.ui.view">
        <field name="name">purchase.order.tree.sale.order.id</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_order_name" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
