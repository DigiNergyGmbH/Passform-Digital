<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_customer_contact_name" model="ir.ui.view">
        <field name="name">sale.order.form.customer.contact.name</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="customer_contact_name"
                       string="Besteller (Kunde)"
                       placeholder="Name der Person, die den Auftrag erteilt hat"/>
            </xpath>
        </field>
    </record>

</odoo>
