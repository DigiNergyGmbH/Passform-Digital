<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Print the Erzberger invoice layout for the Factur-X (ZUGFeRD)
            hybrid PDF as well.

            account_edi_ubl_cii only embeds the XML into a PDF whose report
            name is listed here.  Without it, Odoo renders the *standard*
            report (account.report_invoice_with_payments) and the customer
            receives a generic Odoo invoice with the XML inside instead of the
            real Erzberger invoice.
        -->
        <record id="config_facturx_templates" model="ir.config_parameter">
            <field name="key">account.custom_templates_facturx_list</field>
            <field name="value">erzberger_sale_report.report_invoice_document_custom,erzberger_sale_report.report_invoice_document_custom_holzenberg</field>
        </record>

    </data>
</odoo>
