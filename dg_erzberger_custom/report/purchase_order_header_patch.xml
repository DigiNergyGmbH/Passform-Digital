<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Purchase order / RFQ header - three green logos for Erzberger Holzkunst.

        The invoice and the Auftragsbestätigung print the Holzkunst letterhead
        with three green marks in the header: the company logo, the
        "ECHT ERZGEBIRGE - Holzkunst mit Herz" seal and the
        "Fachhandelsring Erzgebirgische Volkskunst" seal.

        The purchase order is printed with the DIN 5008 layout
        (l10n_din5008.external_layout_din5008, the company's report layout),
        which prints company.logo only - so the same customer got a one-logo
        header on the Bestellung and a three-logo header on the invoice.

        Only the logo cell of that layout is replaced, and only while printing
        a purchase.order of a Holzkunst company; every other document and
        every other company keeps the standard header.
    -->

    <record id="din5008_layout_po_header_client" model="ir.ui.view">
        <field name="name">l10n.din5008.external.layout.po.header.client</field>
        <field name="inherit_id" ref="l10n_din5008.external_layout_din5008"/>
        <field name="arch" type="xml">
            <xpath expr="//table[hasclass('company_header')]//img[@t-if='company.logo']"
                   position="replace">
                <t t-if="o and o._name == 'purchase.order' and 'Holzkunst' in (company.name or '')">
                    <table style="border:0 !important; border-collapse:collapse; padding-top:2mm;">
                        <tr>
                            <td style="border:0 !important; vertical-align:middle; padding:0 4mm 0 0;">
                                <img t-if="company.logo"
                                     t-att-src="image_data_uri(company.logo)"
                                     alt="Logo"
                                     style="height:24mm; width:auto; display:block;"/>
                            </td>
                            <td style="border:0 !important; vertical-align:middle; padding:0;">
                                <img src="/dg_erzberger_custom/static/src/img/logo_echt_erzgebirge.png"
                                     alt="Echt Erzgebirge"
                                     style="height:21mm; width:auto; display:block;"/>
                                <img src="/dg_erzberger_custom/static/src/img/logo_fachhandelsring.png"
                                     alt="Fachhandelsring"
                                     style="height:17mm; width:auto; display:block; margin-top:2.5mm;"/>
                            </td>
                        </tr>
                    </table>
                </t>
                <t t-else="">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                         t-att-style="'max-height: %dmm;' % (din_header_spacing or 27)"/>
                </t>
            </xpath>
        </field>
    </record>

</odoo>
