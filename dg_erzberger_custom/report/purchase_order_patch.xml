<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Purchase order (Bestellung) - core report purchase.report_purchaseorder_document.

        The core template always prints the label "Payment Terms: / Zahlungsbedingungen:"
        even when the purchase order has no payment term, which produces an empty
        line on the PDF (see Bestellung P00044).  The label is now conditional;
        the value node itself already prints nothing when empty.

        NOTE: the real cause of item 4 of the to-do list is on the vendor master
        data - "15 Tage" has to be stored as *supplier* payment term on the vendor
        (and its parent company contact).  dg_erzberger_custom/models/purchase_order.py
        adds a fallback that also looks at the commercial partner.
    -->

    <record id="report_purchaseorder_document_payment_term" model="ir.ui.view">
        <field name="name">report.purchaseorder.document.payment.term</field>
        <field name="inherit_id" ref="purchase.report_purchaseorder_document"/>
        <field name="arch" type="xml">
            <!-- anchored on the field, not the label text: the label is
                 translated (de_DE "Zahlungsbedingungen:") and inheritance is
                 applied per language, so a text match breaks the German PDF -->
            <xpath expr="//span[@t-field='o.payment_term_id']/preceding-sibling::strong[1]"
                   position="attributes">
                <attribute name="t-if">o.payment_term_id</attribute>
            </xpath>
        </field>
    </record>

</odoo>
