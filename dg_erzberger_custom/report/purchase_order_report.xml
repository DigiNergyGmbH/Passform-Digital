<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Bestellung / Angebotsanfrage in the invoice format.

        This template was built directly in the staging database
        (purchase.report_purchaseorder_document_custom_erz) and is brought
        into the repository here unchanged, with ONE difference: the
        letterhead is chosen per company, the same way the invoice does it
        (res.company.use_custom_sale_report):
          - Verpackungssysteme -> report_erz_external_layouts       (blue)
          - Holzkunst          -> report_erz_external_layouts_holzkenber
                                  (company logo + two seals, all green)
        Before, every order used the blue Verpackungssysteme letterhead, so a
        Holzkunst order did not look like a Holzkunst invoice.
    -->

    <template id="report_purchaseorder_document_dg">

    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
    <t t-set="company" t-value="o.company_id.sudo()"/>
    <t t-call="{{ 'erzberger_sale_report.report_erz_external_layouts' if company.use_custom_sale_report else 'erzberger_sale_report.report_erz_external_layouts_holzkenber' }}">

        <div class="page" style="font-family: Arial, sans-serif; font-size: 11pt; color: #222;">
            <style>
                .erz-title { font-size:15pt; font-weight:bold; text-decoration:underline; margin-bottom:1mm; }
                .erz-ref   { font-size:11pt; line-height:1.55; }
                .meta-lbl  { color:#333; white-space:nowrap; padding-right:3mm; font-size:8.5pt; }
                .meta-val  { font-weight:bold; text-align:right; font-size:8.5pt; }
                .otbl, .otbl table, .otbl thead, .otbl tbody, .otbl tr, .otbl th, .otbl td {
                    border: none !important;
                    border-top: none !important;
                    border-bottom: none !important;
                    border-left: none !important;
                    border-right: none !important;
                    outline: none !important;
                    box-shadow: none !important;
                }
                .otbl { width:100%; border-collapse:collapse; margin-top:1mm; }
                .otbl thead th { font-size:11pt; padding:1.5mm 2mm; font-weight:bold; }
                .otbl tbody td { font-size:11pt; padding:2mm; vertical-align:top; }
                .sub { font-weight:normal; font-size:9.5pt; }
                .delivery { font-size:8pt; margin:1.5mm 0; }
                .tot-inner td { font-size:11pt; padding:0.8mm 2mm; }
                .tot-grand td { font-weight:bold; border-top:1.5px solid #000; padding-top:1.5mm; }
                .erz-terms { font-size:11pt; margin-top:3mm; line-height:1.55; }
                .tr { text-align:right; } .tl { text-align:left; } .b { font-weight:bold; }
                p  { margin:0 0 1mm 0; }
            </style>

            <!-- Lieferantenanschrift -->
            <div style="font-size:11pt; line-height:1.65; margin:3mm 0;">
                <t t-if="o.partner_id.parent_id">
                    <div><t t-esc="o.partner_id.parent_id.name"/></div>
                </t>
                <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}"/>
            </div>

            <!-- Titel links, Metadaten rechts -->
            <table style="width:100%; border-collapse:collapse; margin-top:2mm; border:1px solid white; font-size:11pt;">
                <tr>
                    <td style="width:58%; vertical-align:top; padding-right:6mm; padding-top:8mm; border:1px solid white;">
                        <t t-if="o.state in ('purchase', 'done')">
                            <div class="erz-title" style="font-size:18pt;">Bestellung</div>
                        </t>
                        <t t-elif="o.state == 'cancel'">
                            <div class="erz-title" style="font-size:18pt;">Stornierte Bestellung</div>
                        </t>
                        <t t-else="">
                            <div class="erz-title" style="font-size:18pt;">Angebotsanfrage</div>
                        </t>
                        <t t-if="o.partner_ref">
                            <div class="erz-ref" style="padding-top:2mm;">
                                (Ihr Angebot / Ihre Referenz: <span t-field="o.partner_ref"/>)
                            </div>
                        </t>

                        <!-- Einleitungssatz direkt unter dem Titel -->
                        <t t-if="o.state in ('purchase', 'done')">
                            <div style="font-size:11pt; margin-top:4mm;">
                                hiermit bestellen wir zu den nachstehenden Bedingungen:
                            </div>
                        </t>
                        <t t-elif="o.state != 'cancel'">
                            <div style="font-size:11pt; margin-top:4mm;">
                                bitte unterbreiten Sie uns ein Angebot für folgende Positionen:
                            </div>
                        </t>
                    </td>
                    <td style="width:42%; vertical-align:top; border:1px solid white; font-size:11pt;">
                        <table style="border:1px solid white; width:100%;">
                            <tr style="border:1px solid white;">
                                <td class="meta-lbl" style="border:1px solid white; font-size:11pt; padding-left:50px;">Nr.:</td>
                                <td class="meta-val b" style="font-size:11pt; text-align:left;"><span t-field="o.name"/></td>
                            </tr>
                            <tr style="border:1px solid white;">
                                <td class="meta-lbl" style="border:1px solid white; font-size:11pt; padding-left:50px;">Datum:</td>
                                <td class="meta-val" style="border:1px solid white; font-size:11pt; text-align:left;">
                                    <t t-if="o.state in ('purchase', 'done') and o.date_approve">
                                        <span t-field="o.date_approve" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                    </t>
                                    <t t-else="">
                                        <span t-field="o.date_order" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                    </t>
                                </td>
                            </tr>
                            <t t-if="o.company_id.l10n_de_stnr">
                                <tr style="border:1px solid white;">
                                    <td class="meta-lbl" style="border:1px solid white; font-size:11pt; padding-left:50px;">St.-Nr.:</td>
                                    <td class="meta-val" style="font-size:11pt; text-align:left;"><t t-esc="o.company_id.l10n_de_stnr"/></td>
                                </tr>
                            </t>
                            <t t-if="o.company_id.vat">
                                <tr style="border:1px solid white;">
                                    <td class="meta-lbl" style="border:1px solid white; font-size:11pt; padding-left:50px;">Ust.-IdNr.:</td>
                                    <td class="meta-val" style="font-size:11pt; text-align:left;"><span t-field="o.company_id.vat"/></td>
                                </tr>
                            </t>
                            <t t-if="o.user_id">
                                <tr style="border:1px solid white;">
                                    <td class="meta-lbl" style="border:1px solid white; font-size:11pt; padding-left:50px;">Bearbeiter:</td>
                                    <td class="meta-val" style="font-size:11pt; text-align:left;"><span t-field="o.user_id.name"/></td>
                                </tr>
                            </t>
                            <t t-if="o.partner_ref">
                                <tr style="border:1px solid white;">
                                    <td class="meta-lbl" style="border:1px solid white; font-size:11pt; padding-left:50px;">Ihre Referenz:</td>
                                    <td class="meta-val" style="font-size:11pt; text-align:left;"><span t-field="o.partner_ref"/></td>
                                </tr>
                            </t>
                            <t t-if="o.date_planned">
                                <tr style="border:1px solid white;">
                                    <td class="meta-lbl" style="border:1px solid white; font-size:11pt; padding-left:50px;">Liefertermin:</td>
                                    <td class="meta-val" style="font-size:11pt; text-align:left;">
                                        <span t-field="o.date_planned" t-options="{'widget': 'date', 'format': 'dd.MM.yyyy'}"/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- Positionen -->
            <t t-set="filtered_lines" t-value="o.order_line.filtered(lambda l: l.display_type or l.product_qty != 0)"/>
            <table class="otbl" style="width:94%; margin-top:5mm;">
                <thead>
                    <tr>
                        <th class="tl" style="width:13%;">Menge<br/><span class="sub">kg/Stück</span></th>
                        <th class="tl" style="width:47%;">Bezeichnung</th>
                        <th class="tr" style="width:22%;">Preis/Einheit<br/><span class="sub">per kg/1.000 Stück</span></th>
                        <th class="tr" style="width:18%;">Betrag</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="filtered_lines" t-as="line">
                        <t t-if="line.display_type in ('line_section', 'line_subsection')">
                            <tr>
                                <td colspan="4" style="font-weight:bold; padding-top:3mm;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                            <tr>
                                <td colspan="4" style="padding-left:2mm !important;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr>
                                <td class="tl">
                                    <span t-field="line.product_qty"/>
                                    <span t-field="line.product_uom_id.name" groups="uom.group_uom"/>
                                </td>
                                <td>
                                    <span t-field="line.name"/>
                                    <t t-if="line.discount">
                                        <div class="sub">abzgl. <span t-field="line.discount"/> % Rabatt</div>
                                    </t>
                                </td>
                                <td class="tr">
                                    <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                                <td class="tr">
                                    <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <!-- Summenblock -->
            <table style="width:100%; border-collapse:collapse; border:1px solid white; margin-top:4mm;">
                <tr>
                    <td style="width:40%; border:1px solid white;"/>
                    <td style="width:60%; border:1px solid white; padding-right:45px; vertical-align:top;">
                        <table style="border:1px solid white; margin-left:auto;" class="tot-inner">
                            <t t-set="tax_totals" t-value="o.tax_totals"/>
                            <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                                <tr style="border:1px solid white;">
                                    <td style="text-align:left; border:1px solid white; padding-right:30px; white-space:nowrap;">Warenwert</td>
                                    <td style="text-align:right; border:1px solid white; white-space:nowrap;">
                                        <span t-out="subtotal['base_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                    <tr style="border:1px solid white;">
                                        <td style="text-align:left; border:1px solid white; padding-right:30px; white-space:nowrap;">zzgl. <span t-out="tax_group['group_name']"/></td>
                                        <td style="text-align:right; border:1px solid white; white-space:nowrap;">
                                            <span t-out="tax_group['tax_amount_currency']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <tr style="border:1px solid white;" class="tot-grand">
                                <td class="b" style="text-align:left; border:1px solid white; padding-right:30px; white-space:nowrap;">Gesamtbetrag</td>
                                <td class="b" style="text-align:right; border:1px solid white; white-space:nowrap;">
                                    <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <!-- Bedingungen links, abweichende Lieferanschrift rechts -->
            <table style="width:100%; border-collapse:collapse; border:1px solid white;">
                <tr>
                    <td t-att-style="'width:%s; border:1px solid white; vertical-align:top;' % ('62%' if o.dest_address_id else '100%')">
                        <div class="erz-terms">
                            <t t-if="o.payment_term_id">
                                <p>Zahlungsbedingungen: <span t-field="o.payment_term_id.name"/>.</p>
                            </t>
                            <t t-if="o.incoterm_id">
                                <p>Lieferbedingung: <span t-field="o.incoterm_id.name"/></p>
                            </t>
                            <t t-if="not is_html_empty(o.note)">
                                <span t-out="o.note"/>
                            </t>
                        </div>
                    </td>
                    <td t-if="o.dest_address_id" style="width:38%; border:1px solid white; vertical-align:top; padding-left:6mm; padding-top:9mm; font-size:11pt; line-height:1.5;">
                        <span class="b">Lieferanschrift:</span>
                        <div t-field="o.dest_address_id" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}" name="purchase_shipping_address"/>
                    </td>
                </tr>
            </table>

            <!-- Odoo-Portalverknüpfung (Standardfunktion, nur bei Portal-Lieferanten mit EDI) -->
            <t t-set="base_address" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
            <t t-set="portal_url" t-value="base_address + '/my/purchase/' + str(o.id) + '#portal_connect_software_modal'"/>
            <div t-if="any(u._is_portal() for u in o.partner_id.user_ids) and o._get_edi_builders()" class="text-center mt-3" style="font-size:9pt;">
                <a t-att-href="portal_url">Verbinden Sie Ihre Software</a>
                mit <t t-out="o.company_id.name"/>, um Angebote automatisch zu erstellen.
            </div>
        </div>
    </t>

    </template>

    <!-- point the standard order report at the template above -->
    <template id="report_purchaseorder_dg" inherit_id="purchase.report_purchaseorder">
        <xpath expr="//t[@t-call='purchase.report_purchaseorder_document']" position="attributes">
            <attribute name="t-call">dg_erzberger_custom.report_purchaseorder_document_dg</attribute>
        </xpath>
    </template>

    <!-- One paper format for both letterheads. The Holzkunst letterhead is taller than the
         blue one (65 mm top margin on its invoice; with the 55 mm of the other format the
         first recipient line was cut off), the blue footer is taller than the Holzkunst one
         (30 mm bottom margin; with 25 mm its last lines ran off the page). -->
    <record id="paperformat_purchase_order_dg" model="report.paperformat">
        <field name="name">Bestellung Erzberger A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">65</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">65</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="paperformat_id" ref="dg_erzberger_custom.paperformat_purchase_order_dg"/>
    </record>
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="paperformat_id" ref="dg_erzberger_custom.paperformat_purchase_order_dg"/>
    </record>

</odoo>
