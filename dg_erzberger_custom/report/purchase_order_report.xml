<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Purchase order (Bestellung) - same visual format as the invoice.

        Before this template the purchase order was printed by the standard
        Odoo report (purchase.report_purchaseorder_document), which has its own
        letterhead (blue wordmark, "Poststraße | 19a" return line, generic
        footer).  The invoice and the Auftragsbestätigung already use the
        Erzberger letterhead (erzberger_sale_report.report_erz_external_layouts)
        with the bilingual footer, so the same customer got three different
        document designs.

        This template re-uses that letterhead and repeats the invoice body
        layout: recipient block, document title on the left with the meta block
        on the right, a four column info row, a borderless item table and the
        "Nettobetrag / USt / Gesamt" totals block.
    -->

    <template id="report_purchase_order_custom">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-set="company" t-value="doc.company_id.sudo()"/>

                <t t-call="erzberger_sale_report.report_erz_external_layouts">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 9pt; color:#222;">

                        <style>
                            .po-title { font-size:20pt; font-weight:bold; text-decoration:underline; margin-bottom:2mm; }
                            .po-meta-lbl { color:#333; white-space:nowrap; padding-right:3mm; font-size:11pt; }
                            .po-meta-val { font-size:11pt; text-align:left; white-space:nowrap; }
                            .otbl, .otbl table, .otbl thead, .otbl tbody, .otbl tr, .otbl th, .otbl td {
                                border: none !important; outline: none !important; box-shadow: none !important;
                            }
                            .otbl { width:100%; border-collapse:collapse; }
                            .otbl thead th { font-size:11pt; font-weight:bold; padding:2mm; }
                            .otbl tbody td { font-size:11pt; padding:2mm; vertical-align:top; }
                            .sub { font-size:10pt; }
                            .tr { text-align:right; } .tl { text-align:left; } .tc { text-align:center; }
                            .b { font-weight:bold; }
                            p { font-size:11pt; margin:0 0 2mm 0; }
                        </style>

                        <!-- recipient (vendor) -->
                        <div style="font-size:11pt; line-height:1.65; margin:3mm 0;">
                            <div t-field="doc.partner_id"
                                 t-options="{&quot;widget&quot;:&quot;contact&quot;,&quot;fields&quot;:[&quot;name&quot;,&quot;address&quot;],&quot;no_marker&quot;:True}"/>
                        </div>

                        <table style="width:100%; border-collapse:collapse; margin-top:2mm;">
                            <tr>
                                <td style="width:58%; vertical-align:top; padding-right:6mm; padding-top:7mm;">
                                    <div class="po-title">BESTELLUNG</div>
                                </td>
                                <td style="width:42%; vertical-align:top; font-size:11pt; padding-left:95px;">
                                    <table>
                                        <tr>
                                            <td class="po-meta-lbl" style="padding-right:15px;">Bestellnr.:</td>
                                            <td class="po-meta-val"><span t-field="doc.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="po-meta-lbl" style="padding-right:15px;">Datum:</td>
                                            <td class="po-meta-val">
                                                <span t-field="doc.date_order"
                                                      t-options="{&quot;widget&quot;:&quot;date&quot;,&quot;format&quot;:&quot;dd.MM.yyyy&quot;}"/>
                                            </td>
                                        </tr>
                                        <t t-if="doc.company_id.l10n_de_stnr">
                                            <tr>
                                                <td class="po-meta-lbl" style="padding-right:15px;">St.-Nr.:</td>
                                                <td class="po-meta-val"><t t-esc="doc.company_id.l10n_de_stnr"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.company_id.vat">
                                            <tr>
                                                <td class="po-meta-lbl" style="padding-right:15px;">USt.-IdNr.:</td>
                                                <td class="po-meta-val"><span t-field="doc.company_id.vat"/></td>
                                            </tr>
                                        </t>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- info row -->
                        <table class="otbl" style="width:100%; margin-top:6mm;">
                            <tr>
                                <th style="width:26%; text-align:left;"><b>Bestellreferenz</b></th>
                                <th style="width:26%; text-align:left;"><b>Erwartete Ankunft</b></th>
                                <th style="width:20%; text-align:center;"><b>Incoterm</b></th>
                                <th style="width:28%; text-align:center;"><b>Verkaufsauftrag</b></th>
                            </tr>
                            <tr>
                                <td style="text-align:left;"><span t-field="doc.partner_ref"/></td>
                                <td style="text-align:left;">
                                    <span t-field="doc.date_planned"
                                          t-options="{&quot;widget&quot;:&quot;date&quot;,&quot;format&quot;:&quot;dd.MM.yyyy&quot;}"/>
                                </td>
                                <td style="text-align:center;"><span t-field="doc.incoterm_id"/></td>
                                <td style="text-align:center;"><span t-field="doc.sale_order_id"/></td>
                            </tr>
                        </table>

                        <!-- items -->
                        <table class="otbl" style="width:100%; margin-top:4mm;">
                            <thead>
                                <tr>
                                    <th style="width:14%; text-align:left;"><b>Menge</b><br/><span class="sub">kg/Stück</span></th>
                                    <th style="width:44%; text-align:left;"><b>Bezeichnung</b></th>
                                    <th style="width:14%; text-align:center;"><b>Preis/Einheit</b></th>
                                    <th style="width:10%; text-align:center;"><b>Rabatt</b></th>
                                    <th style="width:18%; text-align:center;"><b>Steuern</b></th>
                                    <th style="width:0%; text-align:right;"><b>Betrag</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <t t-if="line.display_type == 'line_section'">
                                        <tr><td colspan="6" class="b" style="padding-top:3mm;">
                                            <span t-field="line.name"/></td></tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr><td colspan="6" style="font-style:italic;">
                                            <span t-field="line.name"/></td></tr>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td class="tl">
                                                <span t-field="line.product_uom_qty"
                                                      t-options="{&quot;widget&quot;:&quot;float&quot;,&quot;decimal_precision&quot;:&quot;Product Unit&quot;}"/>
                                                <span t-field="line.product_uom_id"/>
                                            </td>
                                            <td><span t-field="line.name"/></td>
                                            <td class="tc">
                                                <span t-field="line.price_unit"
                                                      t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:doc.currency_id}"/>
                                            </td>
                                            <td class="tc">
                                                <t t-if="line.discount">
                                                    <span t-field="line.discount"/> %
                                                </t>
                                            </td>
                                            <td class="tc">
                                                <t t-esc="', '.join(line.tax_ids.mapped('name'))"/>
                                            </td>
                                            <td class="tr">
                                                <span t-field="line.price_subtotal"
                                                      t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:doc.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- totals -->
                        <t t-set="tax_totals" t-value="doc.tax_totals"/>
                        <table class="otbl" style="width:100%; margin-top:3mm;">
                            <tr>
                                <td style="width:55%;"></td>
                                <td style="width:25%; vertical-align:top;">
                                    <div>Nettobetrag</div>
                                    <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                        <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                            <div>zzgl. <span t-out="tax_group['group_name']"/></div>
                                        </t>
                                    </t>
                                    <div class="b">Gesamt</div>
                                </td>
                                <td style="width:20%; vertical-align:top; text-align:right;">
                                    <div>
                                        <span t-out="tax_totals['subtotals'][0]['base_amount_currency']"
                                              t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:doc.currency_id}"/>
                                    </div>
                                    <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                        <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                            <div>
                                                <span t-out="tax_group['tax_amount_currency']"
                                                      t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:doc.currency_id}"/>
                                            </div>
                                        </t>
                                    </t>
                                    <!-- everything from tax_totals: doc.amount_total can be
                                         stale on a draft that was saved before a tax change,
                                         which made net + tax differ from the printed total. -->
                                    <div class="b">
                                        <span t-out="tax_totals['total_amount_currency']"
                                              t-options="{&quot;widget&quot;:&quot;monetary&quot;,&quot;display_currency&quot;:doc.currency_id}"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- notes / terms -->
                        <div style="padding-top:20px; font-size:11pt; line-height:1.6;">
                            <div t-if="doc.note and not is_html_empty(doc.note)" style="text-align:justify; line-height:1.5; margin-bottom:10px;">
                                <span t-out="doc.note"/>
                            </div>
                            <!-- Only when the order carries no free text: the notes
                                 usually already spell out the payment terms, and printing
                                 both produced two contradicting lines on P00041. -->
                            <t t-if="doc.payment_term_id and not doc.note">
                                <p>Zahlungsbedingungen: <span t-field="doc.payment_term_id.name"/>.</p>
                            </t>
                            <div style="page-break-inside: avoid !important; break-inside: avoid !important;">
                                <t t-set="bank" t-value="doc.company_id.bank_ids[:1]"/>
                                <t t-if="bank">
                                    <p class="b">Bankverbindung:  <t t-esc="bank.bank_id.name"/></p>
                                    <div style="text-align:center; font-weight:bold;">IBAN: <t t-esc="bank.acc_number"/></div>
                                    <div style="text-align:center; font-weight:bold;">BIC: <t t-esc="bank.bank_id.bic or ''"/></div>
                                </t>
                                <t t-else="">
                                    <p class="b">Bankverbindung:  Erzgebirgssparkasse</p>
                                    <div style="text-align:center; font-weight:bold;">IBAN: DE37 8705 4000 3612 0096 47</div>
                                    <div style="text-align:center; font-weight:bold;">BIC: WELADED1STB</div>
                                </t>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!--
        Point the two purchase documents at the template above.  Odoo keeps one
        body template for both the request for quotation and the confirmed
        purchase order, so both actions have to move together.
    -->
    <record id="purchase.action_report_purchase_order" model="ir.actions.report">
        <field name="report_name">dg_erzberger_custom.report_purchase_order_custom</field>
        <field name="report_file">dg_erzberger_custom.report_purchase_order_custom</field>
        <field name="paperformat_id"
               ref="erzberger_sale_report.paperformat_sale_order_confirmation"/>
    </record>

    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="report_name">dg_erzberger_custom.report_purchase_order_custom</field>
        <field name="report_file">dg_erzberger_custom.report_purchase_order_custom</field>
        <field name="paperformat_id"
               ref="erzberger_sale_report.paperformat_sale_order_confirmation"/>
    </record>

</odoo>
